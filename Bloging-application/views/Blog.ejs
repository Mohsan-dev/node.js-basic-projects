<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Blog</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <div class="container mt-4">
      <h1><%= blog.title %></h1>
      <img src="<%= blog.coverImageURL %>" alt="cover Image" width="100%" height="6 00px"  />
      <pre class="mt-3" style="white-space: pre-wrap; overflow-wrap: break-word; font-family: inherit;"><%= blog.body %></pre>
    </div>
    <div class="container mt-4">
      <img
        src="<%=blog.createdBy.profileImageURL%>"
        alt="Profile Image"
        width="50px"
      />
      <%=blog.createdBy.fullName %>
    </div>

    <div class="container mt-4">
      <h2>Comments (<%= comments.length %>)</h2>
      <% if (locals.user) { %>
       <form action="/blog/comment/<%= blog._id %>" method="POST">
        <div class="mb-4">
          <input
            type="text"
            placeholder="Enter your comments"
            name="content"
            class="form-control"
          />
          <button class="btn btn-sm btn-primary m-2">Submit</button>
        </div>
      </form>
      <% } %> 
      <div class="container mt-4">
        <% comments.forEach(comment=> { %>
         <div>
          <img src="<%=comment.createdBy.profileImageURL  %>" alt="profileImage", width="50px">
          <%= comment.createdBy.fullName %>
          <pre><%= comment.content %></pre>
         </div>
        <% }) %>
      </div>
    </div>
    <%- include('./partials/scripts') %>
  </body>
</html>
